# Secrets
.env

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/

# Node / Next.js
node_modules/
.next/

# Documents and generated data (never commit real documents)
data/*/*
!data/*/.gitkeep

# Eval reports
eval/reports/*
!eval/reports/.gitkeep

# OS
.DS_Store

# Credential / key files (never commit)
*.cred
*.pem
*.key
*credentials*.json
