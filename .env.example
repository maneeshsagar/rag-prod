# Copy this file to .env and fill in your keys:  cp .env.example .env
# .env is git-ignored. Never commit real keys.

# --- AI providers ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Models: "<provider>/<model id>", provider = anthropic | openai ---
LLM_FAST_MODEL=anthropic/claude-haiku-5-5
LLM_MAIN_MODEL=anthropic/claude-sonnet-5-5
# Used automatically if a model's provider is down / rate-limited / has no key. Empty = off.
LLM_FALLBACK_MODEL=openai/gpt-5
LLM_FAST_FALLBACK_MODEL=openai/gpt-5-mini
# Eval judge: use the provider NOT used for answers (reduces self-preference bias).
LLM_JUDGE_MODEL=openai/gpt-5-mini
# Claude effort for answers: low | medium | high (higher = slower, more thorough)
ANSWER_EFFORT=medium

EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=1024
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# --- Tracing (Langfuse Cloud, optional) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Infrastructure (defaults match docker-compose.yml) ---
DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5433/rag
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333

# --- File storage ---
# local = files in data/storage/ (default).  s3 = any S3-compatible service:
#   SeaweedFS locally (`make s3-up`, S3_ENDPOINT_URL=http://localhost:8333)
#   Amazon S3 on AWS  (S3_ENDPOINT_URL empty; credentials come from the IAM role)
STORAGE_BACKEND=local
S3_ENDPOINT_URL=http://localhost:8333
S3_ACCESS_KEY=rag
S3_SECRET_KEY=ragsecret123
S3_BUCKET=documents
S3_REGION=us-east-1

# --- Login tokens: set a long random value ---
SECRET_KEY=change-me
